generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Theme {
  id         String  @id @default(uuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  slug       String
  configJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages Page[]

  @@unique([userId, slug])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  profileImage String?
  createdAt    DateTime @default(now())

  themes     Theme[]
  pages      Page[]
  components Component[]
  mediaAssets MediaAsset[]
  mediaFolders MediaFolder[]
}

model MediaFolder {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  path       String
  createdAt  DateTime @default(now())

  @@unique([userId, path])
  @@index([userId, createdAt])
}

model MediaAsset {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  folderPath String   @default("")
  mimeType   String
  size       Int
  content    Bytes    @db.ByteA
  createdAt  DateTime @default(now())

  @@index([userId, folderPath])
  @@index([userId, createdAt])
}

model Page {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name   String
  slug   String

  themeId String
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Restrict)

  status      PageStatus @default(DRAFT)
  contentJson Json
  version     Int        @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
}

model Component {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name   String

  contentJson Json
  version     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PageStatus {
  DRAFT
  PUBLISHED
}
